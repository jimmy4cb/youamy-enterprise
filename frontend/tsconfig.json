{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "typeRoots": ["./node_modules/@types", "../node_modules/@types", "../backend/node_modules/@types"],
    "paths": {
      "@/*": ["./*"],
      "@backend/*": ["../backend/*"],
      "next/*": ["./node_modules/next/*", "../node_modules/next/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "**/*.ts", "**/*.tsx", "../backend/**/*.ts"],
  "exclude": ["node_modules", "tsconfig.tsbuildinfo"]
}
